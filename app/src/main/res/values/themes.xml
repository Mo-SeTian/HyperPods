<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HyperPods" parent="Theme.AppCompat.DayNight.NoActionBar">
    </style>

    <style name="Theme.HyperPods.QuickControls" parent="Theme.HyperPods">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.18</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>