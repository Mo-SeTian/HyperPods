<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <queries>
        <package android:name="com.android.bluetooth" />
    </queries>
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperPods">

        <activity android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="chen.action.hyperpods.show_airpods_ui" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Only the verified Bluetooth UID may store a fixed-field failure report. -->
        <receiver android:name=".utils.DiagnosticsHistory" android:exported="true" />
        <!-- The provider verifies the Bluetooth UID and returns only fixed app-policy fields. -->
        <provider android:name=".utils.AppPreferencesProvider"
            android:authorities="${applicationId}.preferences"
            android:exported="true" />
        <!-- Set as Xposed Module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <!-- Set your Xposed Module description -->
        <meta-data
            android:name="xposeddescription"
            android:value="Apple AirPods Support for Xiaomi HyperOS." />

        <!-- The minimum Xposed version number -->
        <!-- Retain 93 to locate and privately migrate existing NSP XML. Runtime policy uses private files + IPC. -->
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
    </application>

</manifest>
